#Chip 16f18875, 32

#Define FlameD ANA3
Dir PortA.3 In
Dim FlameV as Byte
#Define FlameThreshold = 100

#Define Fan PortB.7
Dir Fan Out
Fan = 0

#Define Wall_left_sensor ANA2
#Define Wall_Front_sensor ANA1
Dir PortA.2 In
Dir PortA.1 In
Dim Wall_Left_Value as Byte
Dim Wall_Front_Value as Byte
Dim Wall_Left_Distance as Byte
Dim Wall_Front_Distance as Byte

#Define LCD_LINES 2
#Define LCD_WIDTH 16
#Define LCD_IO 4
#Define LCD_DB4 PortD.4
#Define LCD_DB5 PortD.5
#Define LCD_DB6 PortD.6
#Define LCD_DB7 PortD.7
#Define LCD_RS PortD.0
#Define LCD_RW PortD.1
#Define LCD_ENABLE PortD.2
#Define LCD_SPEED FAST

Dir LCD_RS Out
Dir LCD_RW Out
Dir LCD_ENABLE Out
Dir LCD_DB4 Out
Dir LCD_DB5 Out
Dir LCD_DB6 Out
Dir LCD_DB7 Out

#Define L_Detection PortA.0
Dir L_Detection     In
LCount = 0

INVLA0 = 0

#Define Top_Left_Forwards       PortC.0
#Define Top_Left_Backwards      PortC.1
#Define Top_Right_Forwards      PortC.2
#Define Top_Right_Backwards     PortC.3
#Define Bottom_Left_Forwards    PortB.0
#Define Bottom_Left_Backwards   PortB.1
#Define Bottom_Right_Forwards   PortB.2
#Define Bottom_Right_Backwards  PortB.3

Dir Top_Left_Forwards       Out
Dir Top_Left_Backwards      Out
Dir Top_Right_Forwards      Out
Dir Top_Right_Backwards     Out
Dir Bottom_Left_Forwards    Out
Dir Bottom_Left_Backwards   Out
Dir Bottom_Right_Forwards   Out
Dir Bottom_Right_Forwards   Out

Top_Left_Forwards       =0
Top_Left_Backwards      =0
Top_Right_Forwards      =0
Top_Right_Backwards     =0
Bottom_Left_Forwards    =0
Bottom_Left_Backwards   =0
Bottom_Right_Forwards   =0
Bottom_Right_Forwards   =0

turntime = 20 'time for a 90 degree turn
RoomOneWallCheck = 0

Sub Move_Forwards ()
    Top_Left_Forwards = 1
    Top_Left_Backwards = 0
    Top_Right_Forwards = 0
    Top_Right_Backwards = 1
    Bottom_Left_Forwards = 1
    Bottom_Left_Backwards = 0
    Bottom_Right_Forwards = 0
    Bottom_Right_Backwards = 1

End Sub

Sub Move_Backwards ()
    Top_Left_Forwards = 0
    Top_Left_Backwards = 1
    Top_Right_Forwards = 1
    Top_Right_Backwards = 0
    Bottom_Left_Forwards = 0
    Bottom_Left_Backwards = 1
    Bottom_Right_Forwards = 1
    Bottom_Right_Backwards = 0

End Sub

Sub Move_Left ()
    Top_Left_Forwards = 0
    Top_Left_Backwards = 1
    Top_Right_Forwards = 0
    Top_Right_Backwards = 1
    Bottom_Left_Forwards = 1
    Bottom_Left_Backwards = 0
    Bottom_Right_Forwards = 1
    Bottom_Right_Backwards = 0

End Sub

Sub Move_Right ()
    Top_Left_Forwards = 1
    Top_Left_Backwards = 0
    Top_Right_Forwards = 1
    Top_Right_Backwards = 0
    Bottom_Left_Forwards = 0
    Bottom_Left_Backwards = 1
    Bottom_Right_Forwards = 0
    Bottom_Right_Backwards = 1

End Sub

Sub Spin_Right ()
    Top_Left_Forwards = 1
    Top_Left_Backwards = 0
    Top_Right_Forwards = 0
    Top_Right_Backwards = 1
    Bottom_Left_Forwards = 0
    Bottom_Left_Backwards = 1
    Bottom_Right_Forwards = 1
    Bottom_Right_Backwards = 0

End Sub

Sub Spin_Left ()
    Top_Left_Forwards = 0
    Top_Left_Backwards = 1
    Top_Right_Forwards = 1
    Top_Right_Backwards = 0
    Bottom_Left_Forwards = 1
    Bottom_Left_Backwards = 0
    Bottom_Right_Forwards = 0
    Bottom_Right_Backwards = 1

End Sub

Sub Stop ()
    Top_Left_Forwards = 0
    Top_Left_Backwards = 0
    Top_Right_Forwards = 0
    Top_Right_Backwards = 0
    Bottom_Left_Forwards = 0
    Bottom_Left_Backwards = 0
    Bottom_Right_Forwards = 0
    Bottom_Right_Backwards = 0

End Sub

Sub FlameDetection()
    CLS
    Locate 0,0
    Print "Module"
    Print "Flame Detection"
    if FlameV > 250 Then
        do until FlameV < 100
            Move_Forwards
        Loop
    End If
End Sub

Sub FlameExtinguish()
    do until FlameV > 250
        Fan = 1
    loop
End Sub

Sub Left90()
    Spin_Left
    Wait turntime ms
End Sub

Sub Right90()
    Spin_Right
    Wait turntime ms
End Sub

Do Forever

    Wall_Left_Value = ReadAD( Wall_Left_Sensor )
    Wall_Front_Value = ReadAD( Wall_Front_Sensor )

    Wall_Left_Distance = ( (6787 / (Wall_Left_Value - 3)) - 4) / 5
    Wall_Front_Distance = ( (6787 / (Wall_Front_Value - 3)) - 4) / 5

    If L_Detection = 1 Then
        Move_Forwards
    Else
        LCount = LCount + 1
    End If

    CLS
    Locate 0,0
    Print "Flame"
    Print FlameV

    Locate 1,5
    If FlameV < FlameThreshold Then
        Fan = 1
        print "Hot"
    Else
        Fan = 0
        print "Cold"
    End if

    Wait 150 ms
    
    do while LCount = 0
        Move_Forwards
        if Wall_Left_Distance > 100 Then
            Left90
            Move_Forwards
            wait 50 ms
            Left90
            Move_Forwards
        End if
    Loop        

    If LCount = 1 Then
        FlameDetection

        if RoomOneWallCheck = 1 Then
            if Wall_Front_Distance < 50 Then
                Stop
                if FlameV > 300 Then
                    Spin_Right
                    Wait turntime ms
                    RoomOneWallCheck = RoomOneWallCheck + 1
                End If
            End If
        End If

        if RoomOneWallCheck = 2 Then
            do until Wall_Front_Distance < 50
                Move_Forwards
            loop
            RoomOneWallCheck = RoomOneWallCheck + 1
        End If

        if RoomOneWallCheck = 3 Then
            Left90
            do until Wall_Left_Distance > 200
                Move_Forwards
            Loop
            RoomOneWallCheck = RoomOneWallCheck + 1
        End If
    End If

    do while LCount = 2
        do until Front_Wall_Distance < 50
            Move_Forwards
        Loop
        if Front_Wall_Distance < 50 Then
            Left90
        End If
    Loop
        
    do while LCount = 3
        FlameDetection
        FlameExtinguish
    Loop
    
Loop